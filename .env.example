APP_NAME=RWA AI Platform
APP_ENV=development
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000

GOOGLE_API_KEY=

REDIS_URL=redis://localhost:6379/0

RWA_API_URL=http://localhost:3000

LOG_LEVEL=INFO

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_RETRIES=2

# OIDC authentication. These must be set to your identity provider values.
# AUTH_JWKS_URL is typically https://<issuer>/.well-known/jwks.json.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URL=
AUTH_CHAT_SCOPE=rwa:chat

# Alternative for an RWA application that signs access tokens with HS256.
# Keep this value in a secret manager; do not commit a real secret.
JWT_SECRET=
AUTH_CHAT_ROLES=investor,admin
